    "retry": "new_request_attempt_new_sidecar_never_overwrite_prior_attempt"
  },
  "observation": {
    "states": [
      "complete",
      "partial",
      "absent"
    ],
    "null_semantics": "unknown_or_not_returned_never_zero",
    "zero_semantics": "provider_explicitly_returned_zero",
    "native_payload": "bounded_canonical_json_of_allowlisted_fields_only",
    "native_payload_digest": "sha256_of_exact_canonical_native_payload",
