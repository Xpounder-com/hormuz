    "type": "nullable_nonnegative_signed_64_bit_integer",
    "derivation": "only_lossless_provider_profile_rules_may_populate_a_normalized_column",
    "derived_arithmetic": "checked_integer_arithmetic_overflow_makes_the_derived_field_null_and_observation_partial",
    "no_double_counting": "aggregate_dimensions_are_labeled_and_never_summed_with_their_components",
    "legacy_usage_projection": "existing_usage_v1_fields_keep_their_current_protocol_specific_meanings",
    "dimensions": [
