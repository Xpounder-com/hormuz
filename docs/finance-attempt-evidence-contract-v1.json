    "occurred_at": "reuse_the_exact_terminal_attempt_event_timestamp_never_sample_a_second_clock"
  },
  "terminal_cardinality": {
    "pending": "sidecar_prohibited",
    "succeeded": "exactly_one_sidecar_and_usage_event_required",
    "failed": "exactly_one_sidecar_and_usage_event_required",
    "rate_limited": "exactly_one_sidecar_and_usage_event_required",
    "outcome_unknown": "exactly_one_sidecar_usage_event_null_and_observation_partial_or_absent",
