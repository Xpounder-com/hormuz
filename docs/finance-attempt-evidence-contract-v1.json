    "provider_schema_version": 1,
    "parse_failure": "terminal_attempt_commits_with_partial_or_absent_observation_and_content_free_reason_code",
    "unknown_fields": "ignored_not_persisted"
  },
  "normalized_metrics": {
    "columns": [
      "provider_input_tokens",
      "provider_output_tokens",
      "cache_read_input_tokens",
      "cache_write_input_tokens",
