      "required_paths": [
        "input_tokens",
        "output_tokens"
      ],
      "allowlisted_paths": [
        "input_tokens",
        "cache_read_input_tokens",
        "cache_creation_input_tokens",
        "cache_creation.ephemeral_5m_input_tokens",
        "cache_creation.ephemeral_1h_input_tokens",
        "output_tokens",
        "output_tokens_details.thinking_tokens",
        "server_tool_use.web_search_requests",
        "server_tool_use.web_fetch_requests",
        "service_tier",
        "inference_geo"
      ],
      "total_input_rule": "input_tokens_plus_cache_read_input_tokens_plus_cache_creation_input_tokens_only_when_all_terms_are_known",
      "cache_creation_breakdown": "five_minute_and_one_hour_values_are_components_of_cache_creation_input_tokens",
      "service_tier_values": [
        "standard",
        "priority",
        "batch"
      ],
      "inference_geo_syntax": "ascii_safe_identifier_v1_not_a_semantic_region_mapping",
      "billable_tokens": "unknown_unless_the_provider_explicitly_returns_a_billable_field_in_a_reviewed_successor_profile",
      "references": [
        "https://platform.claude.com/docs/en/api/typescript/messages",
        "https://platform.claude.com/docs/en/build-with-claude/prompt-caching"
      ]
    }
  },
  "attempt_price_binding": {
