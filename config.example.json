{
  "listen": {
    "host": "127.0.0.1",
    "port": 8765
  },
  "database": "./hormuz.sqlite3",
  "upstreams": {
    "local-llama": {
      "protocol": "openai",
      "base_url": "http://127.0.0.1:8080",
      "locality": "local",
      "authentication": "none"
    }
  },
  "identities": [
    {
      "token_env": "HORMUZ_GATEWAY_TOKEN",
      "actor_id": "local-user",
      "actor_name": "Local user",
      "team_id": "local",
      "team_name": "Local",
      "allowed_clients": [
        "codex"
      ]
    }
  ],
  "model_routes": {
    "local-code": {
      "protocol": "openai",
      "destination": "local-llama",
      "upstream_model": "replace-with-local-model-id",
      "model_revision": "replace-with-verified-model-revision",
      "capabilities": [
        "responses",
        "text"
      ]
    }
  },
  "policies": {
    "organization": {
      "allowed_clients": [
        "codex"
      ],
      "allowed_models": [
        "local-code"
      ],
      "max_output_tokens": 1024
    }
  },
  "route_admission": {
    "mode": "local_only",
    "local_routes": {}
  },
  "ai_work": {
    "enabled": true,
    "database": "./hormuz-work.sqlite3"
  }
}
