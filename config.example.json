{
  "listen": {
    "host": "127.0.0.1",
    "port": 8787
  },
  "database": "./hormuz.sqlite3",
  "context_database": "./hormuz-context.sqlite3",
  "context_service": {
    "policy_version": "engineering-context-v1",
    "max_token_budget": 32768,
    "max_items": 20,
    "requests_per_minute": 60,
    "allow_provisional": false,
    "lifecycle": {
      "enabled": false,
      "policy_version": "engineering-lifecycle-v1",
      "job_batch_size": 100,
      "lease_seconds": 30,
      "promotion_paths": [
        {
          "id": "merged-and-green",
          "record_kinds": ["claim"],
          "required_signals": ["commit_merged", "ci_passed"]
        },
        {
          "id": "accepted-review",
          "record_kinds": ["claim"],
          "required_signals": ["review_accepted"]
        },
        {
          "id": "approved-adr",
          "record_kinds": ["decision"],
          "required_signals": ["adr_approved"]
        },
        {
          "id": "resolved-incident",
          "record_kinds": ["claim"],
          "required_signals": ["incident_resolved"]
        },
        {
          "id": "human-confirmed",
          "record_kinds": ["claim", "decision"],
          "required_signals": ["human_confirmed"]
        },
        {
          "id": "validated-failure",
          "record_kinds": ["claim"],
          "required_signals": ["failed_attempt_validated"],
          "required_tags": ["negative_knowledge"]
        }
      ]
    }
  },
  "max_request_bytes": 26214400,
  "upstream_timeout_seconds": 600,
  "upstreams": {
    "openai": {
      "base_url": "https://api.openai.com",
      "api_key_env": "OPENAI_API_KEY",
      "allow_response_storage": false,
      "allow_background": false
    },
    "anthropic": {
      "base_url": "https://api.anthropic.com",
      "api_key_env": "ANTHROPIC_API_KEY"
    }
  },
  "authentication": {
    "session_broker": {
      "enabled": false
    },
    "oidc": {
      "issuers": []
    }
  },
  "identities": [
    {
      "token_env": "HORMUZ_TOKEN",
      "actor_id": "alice",
      "actor_name": "Alice Example",
      "team_id": "engineering",
      "team_name": "Engineering",
      "organization_id": "xpounder",
      "clearance": "confidential",
      "allowed_clients": ["codex", "claude-code"],
      "capabilities": []
    }
  ],
  "model_routes": {
    "gpt-5.4-mini": {
      "protocol": "openai",
      "upstream_model": "gpt-5.4-mini",
      "rate_card_version": "example-2026-08-15-v1",
      "currency": "USD",
      "input_cost_per_million": 0.75,
      "cache_read_cost_per_million": 0.075,
      "cache_write_cost_per_million": 0.75,
      "output_cost_per_million": 4.5
    },
    "gpt-5.4": {
      "protocol": "openai",
      "upstream_model": "gpt-5.4",
      "rate_card_version": "example-2026-08-15-v1",
      "currency": "USD",
      "input_cost_per_million": 2.5,
      "cache_read_cost_per_million": 0.25,
      "cache_write_cost_per_million": 2.5,
      "output_cost_per_million": 15.0
    },
    "gpt-5.5": {
      "protocol": "openai",
      "upstream_model": "gpt-5.5",
      "rate_card_version": "example-2026-08-15-v1",
      "currency": "USD",
      "input_cost_per_million": 5.0,
      "cache_read_cost_per_million": 0.5,
      "cache_write_cost_per_million": 5.0,
      "output_cost_per_million": 30.0
    },
    "claude-sonnet-5": {
      "protocol": "anthropic",
      "upstream_model": "claude-sonnet-5",
      "rate_card_version": "example-2026-08-15-v1",
      "currency": "USD",
      "input_cost_per_million": 2.0,
      "cache_read_cost_per_million": 0.2,
      "cache_write_cost_per_million": 2.5,
      "output_cost_per_million": 10.0
    },
    "claude-opus-5": {
      "protocol": "anthropic",
      "upstream_model": "claude-opus-5",
      "rate_card_version": "example-2026-08-15-v1",
      "currency": "USD",
      "input_cost_per_million": 5.0,
      "cache_read_cost_per_million": 0.5,
      "cache_write_cost_per_million": 6.25,
      "output_cost_per_million": 25.0
    }
  },
  "egress_controls": {
    "secrets": {
      "mode": "redact",
      "builtins": true,
      "custom_secret_envs": []
    },
    "dlp": {
      "policy_version": "organization-dlp-v1",
      "approval": {
        "enabled": false
      },
      "rules": {
        "us_ssn": {
          "action": "redact",
          "providers": ["openai", "anthropic"]
        },
        "payment_card": {
          "action": "redact",
          "providers": ["openai", "anthropic"]
        },
        "email_address": {
          "action": "detect",
          "providers": ["openai", "anthropic"]
        },
        "opaque_media": {
          "action": "deny",
          "providers": ["openai", "anthropic"]
        }
      },
      "dictionaries": [],
      "overlays": {
        "teams": {
          "engineering": {
            "policy_version": "engineering-dlp-v1",
            "rules": {
              "email_address": {
                "action": "redact"
              }
            }
          }
        },
        "actors": {}
      }
    }
  },
  "policies": {
    "organization": {
      "allowed_clients": ["codex", "claude-code"],
      "allowed_models": [
        "gpt-5.4-mini",
        "gpt-5.4",
        "gpt-5.5",
        "claude-sonnet-5",
        "claude-opus-5"
      ],
      "max_output_tokens": 32000,
      "monthly_budget_usd": 10000,
      "per_actor_monthly_budget_usd": 500
    },
    "teams": {
      "engineering": {
        "allowed_models": [
          "gpt-5.4-mini",
          "gpt-5.4",
          "gpt-5.5",
          "claude-sonnet-5",
          "claude-opus-5"
        ],
        "fallback_models": {
          "openai": "gpt-5.4-mini",
          "anthropic": "claude-sonnet-5"
        },
        "max_output_tokens": 16000,
        "monthly_budget_usd": 5000
      }
    },
    "actors": {}
  }
}
