        },
        "organization_id": {
          "$ref": "#/$defs/opaque_id",
          "description": "Server-resolved organization; output only, never accepted as input authority."
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hormuz.work-scope-version"
          },
          "minItems": 0,
          "maxItems": 100,
          "description": "Authorized frozen-window records in deterministic time-plus-ID order."
        },
        "as_of": {
          "$ref": "#/$defs/timestamp",
          "description": "Frozen query snapshot ceiling; unchanged across cursor pages."
        },
        "has_more": {
          "type": "boolean",
          "description": "True only if another authorized page exists."
        },
        "next_cursor": {
          "anyOf": [
            {
              "$ref": "#/$defs/opaque_cursor"
            },
            {
              "type": "null"
            }
          ],
          "description": "Non-null exactly when has_more is true; cursor binds scope, filters, window, ordering, and schema."
        }
      },
      "required": [
        "schema_id",
        "schema_version",
        "organization_id",
        "items",
        "as_of",
        "has_more",
        "next_cursor"
      ],
      "description": "Closed collection envelope. Unsupported role/resource combinations are denied before query; this schema never grants access."
    },
    "hormuz.work-scope-version": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_id": {
          "type": "string",
          "const": "hormuz.work-scope-version",
          "description": "Immutable Hormuz schema identity."
        },
        "schema_version": {
          "type": "integer",
          "const": 1,
          "description": "Version 1 of this planned wire contract."
        },
        "organization_id": {
          "$ref": "#/$defs/opaque_id",
          "description": "Server-resolved organization; output only, never accepted as input authority."
        },
        "work_scope_id": {
          "$ref": "#/$defs/opaque_id",
          "description": "Stable organization-local scope ID."
        },
        "version": {
          "$ref": "#/$defs/version",
          "description": "Immutable scope version."
        },
        "kind": {
          "type": "string",
          "enum": [
            "portfolio",
            "initiative",
            "use_case"
          ],
          "description": "Immutable canonical hierarchy kind."
        },
        "parent": {
          "anyOf": [
            {
              "$ref": "#/$defs/work_scope_ref"
            },
            {
              "type": "null"
            }
          ],
          "description": "Versioned nearest configured ancestor; null means organization root."
        },
        "owner_team_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/opaque_id"
            },
            {
              "type": "null"
            }
          ],
          "description": "Existing owner-team reference, not actor performance metadata."
        },
        "display_name": {
          "anyOf": [
            {
              "$ref": "#/$defs/display_name"
            },
            {
              "type": "null"
            }
          ],
          "description": "Authorized registry display only; null after label tombstone. Never included in routine evidence."
        },
        "state": {
          "type": "string",
          "enum": [
            "active",
            "archived",
            "tombstoned"
          ],
          "description": "Current version lifecycle."
        },
        "supersedes_version": {
          "anyOf": [
            {
              "$ref": "#/$defs/version"
            },
            {
              "type": "null"
            }
          ],
          "description": "Prior immutable scope version, or null for creation."
        },
        "actor_id": {
          "$ref": "#/$defs/opaque_id",
          "description": "Authenticated administrator responsible for this version."
        },
        "reason_code": {
          "$ref": "#/$defs/reason_code"
        },
        "event_at": {
          "$ref": "#/$defs/timestamp",
          "description": "Source/domain event time as observed; never scope authority."
        },
        "observed_at": {
          "$ref": "#/$defs/timestamp",
          "description": "Connector/server observation time, preserved separately."
        },
        "ingested_at": {
          "$ref": "#/$defs/timestamp",
          "description": "Database commit time authoritative for receipt and retention."
        }
      },
      "required": [
        "schema_id",
        "schema_version",
        "organization_id",
        "work_scope_id",
        "version",
        "kind",
        "parent",
        "owner_team_id",
        "display_name",
        "state",
        "supersedes_version",
        "actor_id",
        "reason_code",
        "event_at",
        "observed_at",
        "ingested_at"
      ],
      "description": "Immutable bounded registry version. Labels are excluded from release/evaluation evidence even though this authorized resource permits them."
    },
    "hormuz.work-scope-version-request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_id": {
          "type": "string",
          "const": "hormuz.work-scope-version-request",
          "description": "Immutable Hormuz schema identity."
        },
        "schema_version": {
          "type": "integer",
          "const": 1,
          "description": "Version 1 of this planned wire contract."
        },
        "expected_version": {
          "$ref": "#/$defs/version",
          "description": "Optimistic compare-and-set guard; mismatch fails without mutation."
        },
        "parent_work_scope_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/opaque_id"
            },
            {
              "type": "null"
            }
          ],
          "description": "Authorized nearest ancestor reference, or organization root."
        },
        "owner_team_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/opaque_id"
            },
            {
              "type": "null"
            }
          ],
          "description": "Authorized existing team ownership reference."
        },
        "display_name": {
          "anyOf": [
            {
              "$ref": "#/$defs/display_name"
            },
            {
              "type": "null"
            }
          ],
          "description": "Null for a tombstoned label; not deletion of linked facts."
        },
        "state": {
          "type": "string",
          "enum": [
            "active",
            "archived",
            "tombstoned"
          ],
          "description": "Requested scope lifecycle transition."
        },
        "reason_code": {
          "type": "string",
          "enum": [
            "corrected",
            "reparented",
            "archived",
            "reactivated",
            "tombstoned"
          ],
          "description": "Fixed reason for a full replacement version."
        }
      },
      "required": [
        "schema_id",
        "schema_version",
        "expected_version",
        "parent_work_scope_id",
        "owner_team_id",
        "display_name",
        "state",
        "reason_code"
      ],
      "description": "Append a full replacement scope version, never mutate old rows. The URL owns work_scope_id; kind cannot change."
    },
    "opaque_cursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^[A-Za-z0-9_-]+(?![\\s\\S])",
      "description": "Server-authenticated opaque cursor, never a raw SQL offset or tenant selector."
    },
    "opaque_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*(?![\\s\\S])",
      "description": "Opaque server-issued or server-registered identifier, never a name, path, free-text label, or authority. Resolve within the authenticated organization; do not infer access from syntax."
    },
    "reason_code": {
      "type": "string",
      "enum": [
        "created",
        "corrected",
        "reparented",
        "archived",
        "reactivated",
        "tombstoned",
        "bound",
        "voided",
        "accepted",
        "rejected",
        "superseded",
        "expired",
        "policy_drift",
        "scorecard_drift",
        "observed",
        "duplicate",
        "unsupported",
        "unmatched",
        "ambiguous",
        "excluded",
        "missing_evidence",
        "below_threshold",
        "eligible",
        "not_applicable"
      ],
      "description": "Fixed content-free classification, never caller free text or the rejected value."
    },
    "timestamp": {
      "type": "string",
      "minLength": 20,
      "maxLength": 27,
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z(?![\\s\\S])",
      "description": "Valid UTC RFC3339 instant with at most microsecond precision. Invalid calendar dates are rejected; no local or client-implied time zone."
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647,
      "description": "Positive immutable entity or rule version; never a mutable latest alias."
    },
    "work_scope_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "work_scope_id": {
          "$ref": "#/$defs/opaque_id",
          "description": "Canonical work scope in the authenticated organization."
        },
        "version": {
          "$ref": "#/$defs/version",
          "description": "Event-time version; do not rebind historical facts to the current version."
        }
      },
      "required": [
        "work_scope_id",
        "version"
      ],
      "description": "Tenant-qualified versioned work scope; a primary analytic binding must resolve to kind use_case."
    }
  },
  "schema_ids": [
    "hormuz.external-work-binding-event",
    "hormuz.external-work-binding-page",
    "hormuz.external-work-binding-request",
    "hormuz.portfolio-error",
    "hormuz.portfolio-query",
    "hormuz.work-scope-create-request",
    "hormuz.work-scope-page",
    "hormuz.work-scope-version",
    "hormuz.work-scope-version-request"
  ]
}
