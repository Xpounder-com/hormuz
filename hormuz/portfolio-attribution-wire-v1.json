{
  "schema_ids": [
    "hormuz.governed-run-attribution-event",
    "hormuz.governed-run-attribution-page",
    "hormuz.governed-run-attribution-request"
  ],
  "$defs": {
    "opaque_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*(?![\\s\\S])",
      "description": "Opaque server-issued or server-registered identifier, never a name, path, free-text label, or authority. Resolve within the authenticated organization; do not infer access from syntax."
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647,
      "description": "Positive immutable entity or rule version; never a mutable latest alias."
    },
    "timestamp": {
      "type": "string",
      "minLength": 20,
      "maxLength": 27,
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z(?![\\s\\S])",
      "description": "Valid UTC RFC3339 instant with at most microsecond precision. Invalid calendar dates are rejected; no local or client-implied time zone."
    },
    "reason_code": {
      "type": "string",
      "enum": [
        "created",
        "corrected",
        "reparented",
        "archived",
        "reactivated",
        "tombstoned",
        "bound",
        "voided",
        "accepted",
        "rejected",
        "superseded",
        "expired",
        "policy_drift",
        "scorecard_drift",
        "observed",
        "duplicate",
        "unsupported",
        "unmatched",
        "ambiguous",
        "excluded",
        "missing_evidence",
        "below_threshold",
        "eligible",
        "not_applicable"
      ],
      "description": "Fixed content-free classification, never caller free text or the rejected value."
    },
    "work_scope_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "work_scope_id": {
          "$ref": "#/$defs/opaque_id",
          "description": "Canonical work scope in the authenticated organization."
        },
        "version": {
          "$ref": "#/$defs/version",
          "description": "Event-time version; do not rebind historical facts to the current version."
        }
      },
      "required": [
        "work_scope_id",
        "version"
      ],
      "description": "Tenant-qualified versioned work scope; a primary analytic binding must resolve to kind use_case."
    },
    "hormuz.governed-run-attribution-request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_id": {
          "type": "string",
          "const": "hormuz.governed-run-attribution-request",
          "description": "Immutable Hormuz schema identity."
        },
        "schema_version": {
          "type": "integer",
          "const": 1,
          "description": "Version 1 of this planned wire contract."
        },
        "request_attempt_id": {
          "$ref": "#/$defs/opaque_id",
          "description": "Existing immutable tenant-local v1 request attempt."
        },
        "work_scope": {
          "anyOf": [
            {
              "$ref": "#/$defs/work_scope_ref"
            },
            {
              "type": "null"
            }
          ],
          "description": "Authorized primary use_case; null only for voided attribution."
        },
        "expected_attribution_event_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/opaque_id"
            },
            {
              "type": "null"
            }
          ],
          "description": "Current primary attribution for atomic compare-and-set."
        },
        "state": {
          "type": "string",
          "enum": [
            "active",
            "voided"
          ],
          "description": "Append or void primary attribution; never rewrite v1 evidence."
        },
        "reason_code": {
          "type": "string",
          "enum": [
            "bound",
            "corrected",
            "voided"
          ],
          "description": "Fixed post-run attribution reason."
        }
      },
      "required": [
        "schema_id",
        "schema_version",
        "request_attempt_id",
        "work_scope",
        "expected_attribution_event_id",
        "state",
        "reason_code"
      ],
      "description": "Authorized post-run attribution. Source/confidence/actor/tenant are server-derived; at most one primary use case may be active."
    },
    "hormuz.governed-run-attribution-event": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_id": {
          "type": "string",
          "const": "hormuz.governed-run-attribution-event",
          "description": "Immutable Hormuz schema identity."
        },
        "schema_version": {
          "type": "integer",
          "const": 1,
          "description": "Version 1 of this planned wire contract."
        },
        "organization_id": {
          "$ref": "#/$defs/opaque_id",
          "description": "Server-resolved organization; output only, never accepted as input authority."
        },
        "attribution_event_id": {
          "$ref": "#/$defs/opaque_id",
          "description": "Immutable attribution event."
        },
        "request_attempt_id": {
          "$ref": "#/$defs/opaque_id",
          "description": "Existing immutable v1 request attempt."
        },
        "work_scope": {
          "anyOf": [
            {
              "$ref": "#/$defs/work_scope_ref"
            },
            {
              "type": "null"
            }
          ],
          "description": "Exact primary use-case version, or explicitly unattributed/voided."
        },
        "confidence": {
          "type": "string",
          "enum": [
            "explicit_authorized",
            "server_side_default",
            "authorized_post_run",
            "unattributed",
            "ambiguous"
          ],
          "description": "Binding-source quality, not causal probability."
        },
        "state": {
          "type": "string",
          "enum": [
            "active",
            "superseded",
            "voided"
          ],
          "description": "Append-only attribution lifecycle."
        },
        "supersedes_event_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/opaque_id"
            },
            {
              "type": "null"
            }
          ],
          "description": "Prior attribution event."
        },
        "actor_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/opaque_id"
            },
            {
              "type": "null"
            }
          ],
          "description": "Authenticated actor for a manual correction, otherwise server-owned system event."
        },
        "reason_code": {
          "$ref": "#/$defs/reason_code"
        },
        "event_at": {
          "$ref": "#/$defs/timestamp",
          "description": "Source/domain event time as observed; never scope authority."
        },
        "observed_at": {
          "$ref": "#/$defs/timestamp",
          "description": "Connector/server observation time, preserved separately."
        },
        "ingested_at": {
          "$ref": "#/$defs/timestamp",
          "description": "Database commit time authoritative for receipt and retention."
        }
      },
      "required": [
        "schema_id",
        "schema_version",
        "organization_id",
        "attribution_event_id",
        "request_attempt_id",
        "work_scope",
        "confidence",
        "state",
        "supersedes_event_id",
        "actor_id",
        "reason_code",
        "event_at",
        "observed_at",
        "ingested_at"
      ],
      "description": "One current primary attribution per request attempt; no mutation or backfill of the v1 ledger."
    },
    "hormuz.governed-run-attribution-page": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_id": {
          "type": "string",
          "const": "hormuz.governed-run-attribution-page",
          "description": "Immutable Hormuz schema identity."
        },
        "schema_version": {
          "type": "integer",
          "const": 1,
          "description": "Version 1 of this planned wire contract."
        },
        "organization_id": {
          "$ref": "#/$defs/opaque_id",
          "description": "Server-resolved organization; output only, never accepted as input authority."
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hormuz.governed-run-attribution-event"
          },
          "minItems": 0,
          "maxItems": 100,
          "description": "Authorized frozen-window records in deterministic time-plus-ID order."
        },
        "as_of": {
          "$ref": "#/$defs/timestamp",
          "description": "Frozen query snapshot ceiling; unchanged across cursor pages."
        },
        "has_more": {
          "type": "boolean",
          "description": "True only if another authorized page exists."
        },
        "next_cursor": {
          "anyOf": [
            {
              "$ref": "#/$defs/opaque_cursor"
            },
            {
              "type": "null"
            }
          ],
          "description": "Non-null exactly when has_more is true; cursor binds scope, filters, window, ordering, and schema."
        }
      },
      "required": [
        "schema_id",
        "schema_version",
        "organization_id",
        "items",
        "as_of",
        "has_more",
        "next_cursor"
      ],
      "description": "Closed collection envelope. Unsupported role/resource combinations are denied before query; this schema never grants access."
    },
    "opaque_cursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^[A-Za-z0-9_-]+(?![\\s\\S])",
      "description": "Server-authenticated opaque cursor, never a raw SQL offset or tenant selector."
    }
  }
}
