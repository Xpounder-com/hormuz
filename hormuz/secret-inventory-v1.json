    {
      "key_purpose": "provider_credential",
      "status": "active",
      "material_class": "provider_credential",
      "runtime_consumer": "gateway_runtime",
      "rotation_authority": "custody_operator"
    },
    {
      "key_purpose": "data_encryption",
      "status": "active",
      "material_class": "data_encryption_key",
      "runtime_consumer": "audit_anchor_runtime",
      "rotation_authority": "custody_operator"
    },
    {
      "key_purpose": "identity_connector_secret",
      "status": "reserved",
      "material_class": "identity_connector_secret",
      "runtime_consumer": "not_in_active_core",
      "rotation_authority": "future_design_required"
    },
    {
      "key_purpose": "session_material",
      "status": "reserved",
      "material_class": "session_material",
      "runtime_consumer": "not_in_active_core",
      "rotation_authority": "future_design_required"
    },
