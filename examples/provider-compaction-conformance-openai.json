{
  "listen": {
    "host": "127.0.0.1",
    "port": 8793,
    "shutdown_grace_seconds": 5,
    "max_concurrent_requests": 4,
    "accept_backlog": 16,
    "max_connections": 16,
    "request_header_timeout_seconds": 10,
    "request_body_timeout_seconds": 10
  },
  "database": "./.hormuz-provider-compaction-conformance.sqlite3",
  "context_database": "./.hormuz-provider-compaction-conformance-context.sqlite3",
  "context_service": {
    "policy_version": "provider-compaction-conformance-v1",
    "max_token_budget": 500,
    "max_items": 1,
    "requests_per_minute": 10,
    "allow_provisional": false
  },
  "max_request_bytes": 1048576,
  "upstream_timeout_seconds": 60,
  "upstreams": {
    "openai": {
      "base_url": "https://api.openai.com",
      "api_key_env": "OPENAI_API_KEY",
      "allow_response_storage": false,
      "allow_background": false
    },
    "anthropic": {
      "base_url": "https://api.anthropic.com",
      "api_key_env": "HORMUZ_UNUSED_ANTHROPIC_KEY"
    }
  },
  "authentication": {
    "session_broker": {
      "enabled": false
    },
    "oidc": {
      "issuers": []
    }
  },
  "identities": [
    {
      "token_env": "HORMUZ_CONFORMANCE_TOKEN",
      "actor_id": "provider-compaction-conformance",
      "actor_name": "Provider Compaction Conformance",
      "team_id": "verification",
      "team_name": "Verification",
      "organization_id": "local-verification",
      "allowed_clients": ["codex"],
      "capabilities": []
    }
  ],
  "model_routes": {
    "openai-live-luna": {
      "protocol": "openai",
      "upstream_model": "gpt-5.6-luna",
      "rate_card_version": "openai-public-2026-08-20-v1",
      "currency": "USD",
      "input_cost_per_million": 0.2,
      "cache_read_cost_per_million": 0.02,
      "cache_write_cost_per_million": 0.25,
      "output_cost_per_million": 1.2
    }
  },
  "egress_controls": {
    "secrets": {
      "mode": "redact",
      "builtins": true,
      "custom_secret_envs": []
    },
    "dlp": {
      "policy_version": "provider-compaction-conformance-dlp-v1",
      "approval": {
        "enabled": false
      },
      "rules": {
        "opaque_media": {
          "action": "deny",
          "providers": ["openai"]
        }
      },
      "dictionaries": [],
      "overlays": {
        "teams": {},
        "actors": {}
      }
    }
  },
  "policies": {
    "organization": {
      "allowed_clients": ["codex"],
      "allowed_models": ["openai-live-luna"],
      "max_output_tokens": 100,
      "monthly_budget_usd": 1,
      "per_actor_monthly_budget_usd": 1,
      "context_injection": {
        "mode": "required",
        "allowed_clients": ["codex"],
        "allowed_models": ["openai-live-luna"],
        "allowed_repositories": [],
        "max_classification": "internal",
        "token_budget": 500,
        "max_items": 1
      }
    },
    "teams": {
      "verification": {
        "allowed_models": ["openai-live-luna"],
        "max_output_tokens": 100,
        "monthly_budget_usd": 1
      }
    },
    "actors": {}
  }
}
