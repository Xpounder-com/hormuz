{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "image",
    "imagePullSecrets",
    "replicaCount",
    "configuration",
    "runtimeSecret",
    "service",
    "resources",
    "endpointDrainSeconds",
    "terminationGracePeriodSeconds",
    "podDisruptionBudget",
    "topologySpread",
    "networkPolicy"
  ],
  "properties": {
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "platform"],
      "properties": {
        "schema": {"const": "hormuz.kubernetes-profile.v1"},
        "platform": {"const": "linux/amd64"}
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "digest", "pullPolicy"],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[A-Za-z0-9._:/-]+$"
        },
        "digest": {
          "const": "sha256:8ac24f5c7afb8ce09ec133616de06702f568a2e70594d8034146a131d86e5b67"
        },
        "pullPolicy": {"enum": ["IfNotPresent", "Never"]}
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {"$ref": "#/definitions/localObjectReference"}
    },
    "replicaCount": {"type": "integer", "minimum": 2, "maximum": 32},
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "key", "sha256"],
      "properties": {
        "name": {"$ref": "#/definitions/dnsSubdomain"},
        "key": {"$ref": "#/definitions/secretKey"},
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "runtimeSecret": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "revision", "env"],
      "properties": {
        "name": {"$ref": "#/definitions/dnsSubdomain"},
        "revision": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "env": {
          "type": "object",
          "minProperties": 2,
          "maxProperties": 64,
          "required": ["HORMUZ_POSTGRES_DSN", "HORMUZ_INGRESS_CREDENTIAL"],
          "propertyNames": {
            "not": {
              "pattern": "(_ADMIN_TOKEN|_BREAK_GLASS_TOKEN|_MIGRATION_DSN|_CONTROL_DSN|_EXECUTOR_DSN)$"
            }
          },
          "patternProperties": {
            "^[A-Z][A-Z0-9_]{0,127}$": {"$ref": "#/definitions/secretKey"}
          },
          "additionalProperties": false
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port"],
      "properties": {
        "port": {"type": "integer", "minimum": 1024, "maximum": 65535}
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requests", "limits"],
      "properties": {
        "requests": {"$ref": "#/definitions/resourcePair"},
        "limits": {"$ref": "#/definitions/resourcePair"}
      }
    },
    "endpointDrainSeconds": {"type": "integer", "minimum": 5, "maximum": 300},
    "terminationGracePeriodSeconds": {"type": "integer", "minimum": 60, "maximum": 3600},
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minAvailable"],
      "properties": {
        "minAvailable": {"type": "integer", "minimum": 1, "maximum": 31}
      }
    },
    "topologySpread": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topologyKey"],
      "properties": {
        "topologyKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[A-Za-z0-9./_-]+$"
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "ingress", "egress"],
      "properties": {
        "enabled": {"const": true},
        "ingress": {
          "type": "array",
          "maxItems": 32,
          "items": {"$ref": "#/definitions/ingressRule"}
        },
        "egress": {
          "type": "array",
          "maxItems": 64,
          "items": {"$ref": "#/definitions/egressRule"}
        }
      }
    }
  },
  "definitions": {
    "dnsSubdomain": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
    },
    "secretKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^[-._a-zA-Z0-9]+$"
    },
    "localObjectReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {"name": {"$ref": "#/definitions/dnsSubdomain"}}
    },
    "resourcePair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu", "memory"],
      "properties": {
        "cpu": {"type": "string", "pattern": "^[1-9][0-9]*(m)?$"},
        "memory": {"type": "string", "pattern": "^[1-9][0-9]*(Mi|Gi)$"}
      }
    },
    "labelSelector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["matchLabels"],
      "properties": {
        "matchLabels": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 32,
          "patternProperties": {
            "^[A-Za-z0-9./_-]+$": {"type": "string", "maxLength": 63}
          },
          "additionalProperties": false
        }
      }
    },
    "ipBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cidr"],
      "properties": {
        "cidr": {"type": "string", "minLength": 3, "maxLength": 49},
        "except": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 3, "maxLength": 49}
        }
      }
    },
    "peer": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "namespaceSelector": {"$ref": "#/definitions/labelSelector"},
        "podSelector": {"$ref": "#/definitions/labelSelector"},
        "ipBlock": {"$ref": "#/definitions/ipBlock"}
      }
    },
    "port": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "port"],
      "properties": {
        "protocol": {"enum": ["TCP", "UDP", "SCTP"]},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535}
      }
    },
    "ingressRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "ports"],
      "properties": {
        "from": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/definitions/peer"}},
        "ports": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/definitions/port"}}
      }
    },
    "egressRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["to", "ports"],
      "properties": {
        "to": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/definitions/peer"}},
        "ports": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/definitions/port"}}
      }
    }
  }
}
