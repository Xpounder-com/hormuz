{
  "listen": {
    "host": "0.0.0.0",
    "port": 8787
  },
  "ingress": {
    "mode": "external_tls_proxy",
    "trusted_proxy_cidrs": ["127.0.0.1/32", "172.30.10.0/24", "172.30.11.0/24"],
    "credential_env": "HORMUZ_INGRESS_CREDENTIAL"
  },
  "max_request_bytes": 26214400,
  "upstream_timeout_seconds": 600,
  "usage_storage": {
    "backend": "postgresql",
    "postgres_dsn_env": "HORMUZ_POSTGRES_DSN",
    "postgres_migration_dsn_env": "HORMUZ_POSTGRES_MIGRATION_DSN",
    "postgres_schema": "hormuz",
    "postgres_runtime_role": "hormuz_runtime",
    "postgres_pool": {
      "min_connections": 1,
      "max_connections": 8,
      "acquire_timeout_seconds": 5,
      "max_waiting": 16,
      "max_lifetime_seconds": 3600,
      "max_idle_seconds": 300
    }
  },
  "upstreams": {
    "openai": {
      "base_url": "https://api.openai.com",
      "api_key_env": "OPENAI_API_KEY",
      "allow_response_storage": false,
      "allow_background": false
    },
    "anthropic": {
      "base_url": "https://api.anthropic.com",
      "api_key_env": "ANTHROPIC_API_KEY"
    }
  },
  "authentication": {
    "oidc": {
      "issuers": []
    }
  },
  "identities": [
    {
      "token_env": "HORMUZ_TOKEN",
      "actor_id": "pilot-user",
      "actor_name": "Pilot User",
      "team_id": "pilot-team",
      "team_name": "Pilot Team",
      "organization_id": "pilot-organization",
      "identity_type": "human",
      "clearance": "internal",
      "allowed_clients": ["codex", "claude-code"]
    }
  ],
  "model_routes": {
    "openai-pilot": {
      "protocol": "openai",
      "upstream_model": "gpt-5.4-mini"
    },
    "anthropic-pilot": {
      "protocol": "anthropic",
      "upstream_model": "claude-sonnet-5"
    }
  },
  "egress_controls": {
    "secrets": {
      "mode": "redact",
      "builtins": true,
      "custom_secret_envs": []
    }
  },
  "policies": {
    "organization": {
      "allowed_clients": ["codex", "claude-code"],
      "allowed_models": ["openai-pilot", "anthropic-pilot"],
      "fallback_models": {
        "openai": "openai-pilot",
        "anthropic": "anthropic-pilot"
      },
      "max_output_tokens": 4096,
      "monthly_budget_usd": 1000,
      "per_actor_monthly_budget_usd": 250
    },
    "teams": {},
    "actors": {}
  }
}
