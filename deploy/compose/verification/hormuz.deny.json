{
  "listen": {
    "host": "0.0.0.0",
    "port": 8787
  },
  "ingress": {
    "mode": "external_tls_proxy",
    "trusted_proxy_cidrs": ["127.0.0.1/32", "172.30.10.0/24", "172.30.11.0/24", "172.30.12.0/24"],
    "credential_env": "HORMUZ_INGRESS_CREDENTIAL"
  },
  "max_request_bytes": 1048576,
  "upstream_timeout_seconds": 30,
  "usage_storage": {
    "backend": "postgresql",
    "postgres_dsn_env": "HORMUZ_POSTGRES_DSN",
    "postgres_migration_dsn_env": "HORMUZ_POSTGRES_MIGRATION_DSN",
    "postgres_schema": "hormuz",
    "postgres_runtime_role": "hormuz_runtime",
    "postgres_pool": {
      "min_connections": 1,
      "max_connections": 4,
      "acquire_timeout_seconds": 5,
      "max_waiting": 8,
      "max_lifetime_seconds": 3600,
      "max_idle_seconds": 300
    }
  },
  "upstreams": {
    "openai": {
      "base_url": "http://fake-provider:8090",
      "api_key_env": "OPENAI_API_KEY",
      "allow_response_storage": false,
      "allow_background": false
    },
    "anthropic": {
      "base_url": "http://fake-provider:8090",
      "api_key_env": "ANTHROPIC_API_KEY"
    }
  },
  "authentication": {
    "oidc": {
      "issuers": []
    }
  },
  "identities": [
    {
      "token_env": "HORMUZ_TOKEN",
      "actor_id": "compose-proof-user",
      "actor_name": "Compose Proof User",
      "team_id": "compose-proof-team",
      "team_name": "Compose Proof Team",
      "organization_id": "compose-proof-organization",
      "identity_type": "human",
      "clearance": "internal",
      "allowed_clients": ["codex"]
    }
  ],
  "model_routes": {
    "openai-compose-proof": {
      "protocol": "openai",
      "upstream_model": "gpt-compose-proof",
      "input_cost_per_million": 1,
      "cache_read_cost_per_million": 0.1,
      "output_cost_per_million": 2
    }
  },
  "egress_controls": {
    "secrets": {
      "mode": "deny",
      "builtins": true,
      "custom_secret_envs": []
    }
  },
  "policies": {
    "organization": {
      "allowed_clients": ["codex"],
      "allowed_models": ["openai-compose-proof"],
      "fallback_models": {
        "openai": "openai-compose-proof"
      },
      "max_output_tokens": 64,
      "monthly_budget_usd": 10,
      "per_actor_monthly_budget_usd": 10
    },
    "teams": {},
    "actors": {}
  }
}
