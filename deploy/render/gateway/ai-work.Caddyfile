{
	admin off
	auto_https off
	persist_config off
	grace_period 3s
	log {
		output discard
	}
	servers {
		protocols h1
		max_header_size 16KB
		timeouts {
			read_header 5s
			read_body 30s
			write 0s
			idle 30s
		}
	}
}

# Render terminates public TLS. The backend remains loopback-only and accepts
# eight provider streams plus one liveness connection on the single-node AI Work mode.
:{$PORT:10000} {
	bind 0.0.0.0
	header {
		-Server
		Cache-Control "no-store"
		X-Content-Type-Options "nosniff"
		X-Robots-Tag "noindex, nofollow, noarchive"
	}
	@work {
		path /health /ready /console /console/styles.css /console/policy /console/policy.css /console/policy/activity /console/policy/results /v1/auth/login /v1/auth/join /v1/auth/invitations/accept /v1/auth/callback /v1/auth/enrollments /v1/auth/desktop/enrollments /v1/auth/enrollments/*/redeem /v1/auth/desktop/enrollments/*/redeem /v1/auth/desktop/profile /v1/auth/refresh /v1/auth/logout /v1/admin/me /v1/admin/usage /v1/admin/operations /v1/admin/members /v1/admin/teams /v1/admin/members/disable /v1/admin/auth/callback /v1/admin/auth/start /v1/admin/logout /v1/admin/policy/scopes /v1/admin/policy/results /v1/admin/portfolio/* /workspace /workspace/ /workspace/styles.css /workspace/login /w/workspace-* /v1/workspaces/me /v1/workspaces/auth/start /v1/workspaces/auth/callback /v1/workspaces/auth/handoff /v1/workspaces/logout /v1/workspaces/domains /v1/workspaces/domains/check /v1/workspaces/domains/remove /.well-known/hormuz-domain/* /v1/connectors/github/events /v1/connectors/linear/events /v1/connectors/linear/snapshots /v1/gateway/whoami /v1/gateway/reliability /v1/gateway/usage /v1/responses /v1/responses/compact /v1/messages /v1/messages/count_tokens /v1/models /v1/chat/completions /work /work/ /work.css /work/jobs/* /v1/work/state /v1/work/connect /v1/work/jobs /v1/work/jobs/* /v1/work/policies /v1/work/billing/portal /v1/work/billing/webhook /v1/work/billing/checkout /v1/work/activation /v1/work/activation/request /v1/work/activation/review /v1/work/activation/reset /v1/work/activation/reverify /v1/work/support/receipt /work/acquisition /v1/work/acquisition
	}
	handle @work {
		request_body {
			max_size 2MB
		}
		reverse_proxy 127.0.0.1:8787 {
			# Each available response fragment is flushed immediately. Hormuz owns
			# the upstream response stream and records its own timing evidence.
			flush_interval -1
			header_up X-Hormuz-Ingress-Credential {env.HORMUZ_INGRESS_CREDENTIAL}
			header_up -Forwarded
			header_up -X-Forwarded-*
			header_up -X-Api-Key
			header_up -X-Hormuz-Organization
			header_up -X-Hormuz-Team
			header_up -X-Hormuz-User
			# Portfolio mutations require exactly one validated Idempotency-Key.
			header_up -X-Idempotency-Key
			lb_retries 0
			unhealthy_request_count 9
			transport http {
				versions 1.1
				network_proxy none
				keepalive off
				compression off
				max_conns_per_host 9
				max_response_header 16KB
				dial_timeout 3s
				response_header_timeout 660s
				read_timeout 0s
				write_timeout 30s
			}
		}
	}
	handle {
		respond "{\"schema_id\":\"hormuz.hosted-ai-work\",\"schema_version\":1,\"status\":\"route_disabled\",\"inference_enabled\":true}" 503 {
			close
		}
	}
	handle_errors {
		respond "{\"schema_id\":\"hormuz.hosted-ai-work\",\"schema_version\":1,\"status\":\"request_rejected\",\"inference_enabled\":true}" {err.status_code} {
			close
		}
	}
}
