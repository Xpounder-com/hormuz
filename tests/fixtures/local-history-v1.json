{
  "schema_id": "hormuz.local-history-compatibility",
  "schema_version": 1,
  "schemas": [
    "hormuz.local-history-settings",
    "hormuz.local-history-entry",
    "hormuz.local-history-status",
    "hormuz.local-history-list",
    "hormuz.local-history-review",
    "hormuz.local-history-insights",
    "hormuz.local-history-export",
    "hormuz.local-history-export-result",
    "hormuz.local-history-delete",
    "hormuz.local-history-error"
  ],
  "entry_fields": [
    "id", "recorded_at", "actor_id", "client", "protocol", "requested_model",
    "routed_model", "destination", "locality", "outcome", "http_status",
    "input_tokens", "output_tokens", "estimated_cost_microusd", "cost_reason",
    "latency_ms", "request_text", "response_text", "request_content_status",
    "response_content_status", "schema_id", "schema_version"
  ],
  "content_statuses": ["captured", "unsupported", "omitted_limit", "partial"],
  "outcomes": ["succeeded", "failed", "outcome_unknown", "rate_limited"],
  "limits": {
    "default_retention_days": 30,
    "maximum_retention_days": 365,
    "maximum_entries": 1000,
    "maximum_encrypted_entries_bytes": 33554432,
    "maximum_record_file_bytes": 262144,
    "maximum_text_bytes": 65536,
    "maximum_response_assembly_bytes": 262144
  },
  "default_enabled": false,
  "capture_mode": "redacted_text_and_metadata",
  "encryption_envelope": {
    "algorithm": "AES-256-GCM",
    "header_utf8": "Hormuz local history v1\u0000",
    "nonce_bytes": 12,
    "key_file": "device.key",
    "key_bytes": 32,
    "settings_file": "settings.enc",
    "settings_aad_utf8": "settings-v1",
    "entry_directory": "entries",
    "entry_aad": "entry_id_ascii",
    "layout": "header + nonce + authenticated_ciphertext_with_tag"
  },
  "retention_cleanup": "on_use",
  "cost_basis": "configured_rate_card_estimate",
  "coverage": "retained_opt_in_history_only",
  "migration": "No implicit migration from accounting, app histories or older configurations.",
  "rollback": "Disable and optionally export/delete first. Older routers ignore the separate store."
}
